# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DESKVERSE_LOCAL_DEMO=true

# Neon PostgreSQL (pooled URL for the app, direct URL for migrations)
DATABASE_URL=postgresql://user:password@host/db?sslmode=verify-full
DIRECT_URL=postgresql://user:password@host/db?sslmode=verify-full

# Platform services (optional in local development; adapters expose a clear unavailable state)
REDIS_URL=
UPLOADTHING_TOKEN=
# Vercel AI Gateway (Whisper; em deployments Vercel, OIDC também pode autenticar)
AI_GATEWAY_API_KEY=
AI_GATEWAY_TRANSCRIPTION_MODEL=openai/whisper-1
INFERENCE_GATEWAY_URL=
INFERENCE_GATEWAY_TOKEN=
EVE_RUNTIME_URL=
MCP_CHANNELS_URL=
MCP_MEDIA_URL=
