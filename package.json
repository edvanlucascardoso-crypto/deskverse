{
  "name": "deskverse",
  "private": true,
  "version": "0.1.0",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "prisma migrate deploy && next dev",
    "build": "prisma migrate deploy && prisma generate && next build",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:agent-skills": "node --test agent-skills/compatibility/resolve-skill.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy",
    "db:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.4",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@xyflow/react": "12.11.6",
    "better-auth": "^1.7.4",
    "date-fns": "^4.4.0",
    "lucide-react": "1.45.0",
    "mammoth": "^1.12.3",
    "motion": "13.2.0",
    "next": "16.3.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dnd-touch-backend": "^16.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "uploadthing": "7.7.4",
    "vaul": "1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  }
}
